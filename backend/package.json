{
    "name": "service-center-backend",
    "version": "1.0.0",
    "description": "Backend for service center",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:verbose": "jest --verbose"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "pdfkit": "^0.17.2",
        "pg": "^8.11.3"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.0.1"
    },
    "jest": {
        "testEnvironment": "node",
        "verbose": true,
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "collectCoverageFrom": [
            "server.js",
            "src/**/*.js",
            "!**/node_modules/**"
        ]
    }
}
